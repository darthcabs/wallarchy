{
  "schemaVersion": 1,
  "id": "co.klair.omasplash",
  "name": "Omasplash",
  "version": "0.1.0",
  "author": "klair",
  "license": "MIT",
  "description": "Browse Wallhaven by category or tag, set any wallpaper as your Omarchy background, and rotate on a timer.",
  "homepage": "https://github.com/klair/omasplash",
  "repository": "https://github.com/klair/omasplash",
  "keywords": [
    "wallpaper",
    "background",
    "wallhaven",
    "photos"
  ],
  "kinds": [
    "bar-widget",
    "overlay",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Browser.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Omasplash",
    "description": "Wallhaven wallpaper browser and rotation",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showLabel": false
    },
    "schema": [
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show wallpaper size in the bar",
        "defaultValue": false,
        "description": "Filters and the rotation interval live in the browser overlay (~/.config/omarchy/omasplash.json), not here \u2014 they are shared with the rotation service and the CLI."
      }
    ]
  }
}
